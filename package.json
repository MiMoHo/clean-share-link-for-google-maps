{
  "name": "clean-share-link-for-google-maps",
  "version": "2026.11.1",
  "private": true,
  "description": "Browser extension that replaces Google Maps' tracking short links with clean, documented Maps URLs with Place ID: share dialog, directions panel and the Android share sheet.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "lint": "web-ext lint",
    "build": "web-ext build",
    "check-domains": "node scripts/check-domains.mjs",
    "build:userscript": "node scripts/build-userscript.mjs"
  },
  "devDependencies": {
    "web-ext": "^8.0.0"
  },
  "webExt": {
    "sourceDir": ".",
    "artifactsDir": "dist",
    "ignoreFiles": [
      "test",
      "test/**",
      "scripts",
      "scripts/**",
      "dist",
      "dist/**",
      "docs",
      "docs/**",
      "package.json",
      "package-lock.json",
      "*.md"
    ],
    "build": {
      "overwriteDest": true
    }
  }
}
