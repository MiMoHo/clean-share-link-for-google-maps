{
  "name": "clean-share-link-for-google-maps",
  "version": "2026.10.18",
  "private": true,
  "description": "Browser extension that replaces Google Maps' tracking short links with clean, documented Maps URLs with Place ID: share dialog, directions panel and the Android share sheet.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "lint": "web-ext lint --source-dir . --ignore-files 'test' 'test/**' 'scripts' 'scripts/**' 'dist' 'dist/**' 'package.json' 'package-lock.json' '*.md'",
    "build": "web-ext build --source-dir . --artifacts-dir dist --overwrite-dest --ignore-files 'test' 'test/**' 'scripts' 'scripts/**' 'dist' 'dist/**' 'package.json' 'package-lock.json' '*.md'",
    "check-domains": "node scripts/check-domains.mjs"
  },
  "devDependencies": {
    "web-ext": "^8.0.0"
  }
}
